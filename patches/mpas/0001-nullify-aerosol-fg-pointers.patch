From b64eb47fe900c6324217e9f25daf10c76e4bcaa8 Mon Sep 17 00:00:00 2001
From: Dustin Swales <djs467@gmail.com>
Date: Mon, 26 Oct 2026 14:16:06 -0600
Subject: [PATCH] init_atmosphere: nullify aerosol first-guess pointers before
 conditional fetch

smoke_fine_fg, dust_fine_fg and dust_coarse_fg in init_atm_case_gfs and
init_atm_case_lbc are only set when config_smoke_scheme / config_dust_scheme
are on, but are later tested with associated(). With the schemes off the
pointers are undefined, so associated() can return true and the code reads
through a garbage descriptor: segfault with optimized gfortran builds,
'index below lower bound' with -fcheck=bounds (mpas_init_atm_cases.F:7357).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Kadc7j2btyf9EtMtcXzsmY
---
 src/core_init_atmosphere/mpas_init_atm_cases.F | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/src/core_init_atmosphere/mpas_init_atm_cases.F b/src/core_init_atmosphere/mpas_init_atm_cases.F
index 5c26b11..6c79fa6 100644
--- a/src/core_init_atmosphere/mpas_init_atm_cases.F
+++ b/src/core_init_atmosphere/mpas_init_atm_cases.F
@@ -4441,6 +4441,9 @@ module init_atm_cases
       call mpas_pool_get_array(fg, 'gfs_z', gfs_z)
       call mpas_pool_get_array(fg, 'p', p_fg)
 ! Chemistry
+      ! Nullify first: these are only fetched when the scheme is on, and
+      ! associated() on an undefined pointer is undefined behaviour.
+      nullify(smoke_fine_fg, dust_fine_fg, dust_coarse_fg)
       if ( config_smoke_scheme .ne. 'off' ) then
          call mpas_pool_get_array(fg, 'smoke_fine', smoke_fine_fg)
       endif
@@ -8016,6 +8019,9 @@ call mpas_log_write('Done with soil consistency check')
 ! Chemistry
       call mpas_pool_get_config(configs, 'config_smoke_scheme', config_smoke_scheme)
       call mpas_pool_get_config(configs, 'config_dust_scheme', config_dust_scheme)
+      ! Nullify first: these are only fetched when the scheme is on, and
+      ! associated() on an undefined pointer is undefined behaviour.
+      nullify(smoke_fine_fg, dust_fine_fg, dust_coarse_fg)
       if ( config_smoke_scheme .ne. 'off' ) then
          call mpas_pool_get_array(fg, 'smoke_fine', smoke_fine_fg)
       endif
